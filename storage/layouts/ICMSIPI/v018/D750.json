{
    "COD_MOD": {
        "type": "string",
        "regex": "^(62)$",
        "required": true,
        "info": "C\u00f3digo do modelo do documento fiscal",
        "format": ""
    },
    "SER": {
        "type": "string",
        "regex": "^.{1,3}$",
        "required": true,
        "info": "S\u00e9rie do documento fiscal",
        "format": ""
    },
    "DT_DOC": {
        "type": "string",
        "regex": "^(0[1-9]|[1-2][0-9]|31(?!(?:0[2469]|11))|30(?!02))(0[1-9]|1[0-2])([12]\\d{3})$",
        "required": true,
        "info": "Data da emiss\u00e3o dos documentos",
        "format": ""
    },
    "QTD_CONS": {
        "type": "numeric",
        "regex": "^\\d+$",
        "required": true,
        "info": "Quantidade de documentos consolidados",
        "format": ""
    },
    "IND_PREPAGO": {
        "type": "string",
        "regex": "^[0-1]$",
        "required": true,
        "info": "Forma de pagamento: 0 \u2013 pr\u00e9 pago, 1 \u2013 p\u00f3s pago",
        "format": ""
    },
    "VL_DOC": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": true,
        "info": "Valor total dos documentos",
        "format": "15v2"
    },
    "VL_SERV": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": true,
        "info": "Valor dos servi\u00e7os tributados pelo ICMS",
        "format": "15v2"
    },
    "VL_SERV_NT": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": false,
        "info": "Valores cobrados sem destaque de ICMS",
        "format": "15v2"
    },
    "VL_TERC": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": false,
        "info": "Valor cobrado em nome de terceiros",
        "format": "15v2"
    },
    "VL_DESC": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": false,
        "info": "Valor total dos descontos",
        "format": "15v2"
    },
    "VL_DA": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": false,
        "info": "Valor das despesas acess\u00f3rias",
        "format": "15v2"
    },
    "VL_BC_ICMS": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": true,
        "info": "Valor total da base de c\u00e1lculo do ICMS",
        "format": "15v2"
    },
    "VL_ICMS": {
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "required": true,
        "info": "Valor total do ICMS",
        "format": "15v2"
    },
    "VL_PIS": {
        "required": true,
        "type": "numeric",
        "regex": "^\\d+(\\.\\d*)?|\\.\\d+$",
        "info": "Valor do PIS",
        "format": "15v2"
    },
    "VL_COFINS": {
        "required": true,
